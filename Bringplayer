local targetPlayer = nil

local function findPlayer(nameInput)
	if nameInput == "" then return nil end
	for _, player in ipairs(Players:GetPlayers()) do
		if player ~= LocalPlayer then
			if string.sub(string.lower(player.Name), 1, #nameInput) == string.lower(nameInput) or 
			   string.sub(string.lower(player.DisplayName), 1, #nameInput) == string.lower(nameInput) then
				return player
			end
		end
	end
	return nil
end

TextBox:GetPropertyChangedSignal("Text"):Connect(function()
	targetPlayer = findPlayer(TextBox.Text)
	if targetPlayer and TextBox.Text ~= "" then
		pcall(function()
			local content = Players:GetUserThumbnailAsync(targetPlayer.UserId, Enum.ThumbnailType.HeadShot, Enum.ThumbnailSize.Size150x150)
			AvatarImage.Image = content
			AvatarImage.Visible = true
		end)
	else
		AvatarImage.Image = "rbxassetid://0"
		AvatarImage.Visible = false
	end
end)

-- تنفيذ السحب بضغطة زر واحدة
BringButton.MouseButton1Click:Connect(function()
	if targetPlayer and targetPlayer.Character and targetPlayer.Character:FindFirstChild("HumanoidRootPart") then
		if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
			targetPlayer.Character.HumanoidRootPart.CFrame = LocalPlayer.Character.HumanoidRootPart.CFrame
		end
	end
end)
